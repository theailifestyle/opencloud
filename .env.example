# Example configuration for a fresh install. Every hostname, address, and path
# here is a placeholder. install.sh copies this file to .env once; edit .env on
# the server. Never commit .env.
# Where Open Cloud keeps app config, data, secrets and backups.
OC_ROOT=/srv/opencloud
# Console hostname and the domain apps live under (<app>.OC_APPS_DOMAIN).
OC_CONSOLE_HOST=console.example.com
OC_APPS_DOMAIN=apps.example.com
# Public S3 endpoint hostname (for presigned URLs). App names "s3", "console" are reserved.
OC_S3_HOST=s3.apps.example.com
# 0 = no public S3 site (no DNS or certificate needed for OC_S3_HOST); apps still reach storage:8333 inside.
OC_S3_PUBLIC=1
# "acme" = real certificates from Let's Encrypt (needs DNS pointing here);
# "internal" = Caddy's local CA (for localhost / testing).
OC_TLS=acme
OC_ACME_EMAIL=admin@example.com
# Optional: this server's public IP, shown on the DNS page. Leave empty to skip the
# "DNS points elsewhere" check. Example: OC_PUBLIC_IP=203.0.113.10
OC_PUBLIC_IP=
# Open Bedrock model gateway (optional). Any OpenAI-compatible chat completions URL, e.g.
# https://openrouter.ai/api/v1/chat/completions. Used only on first install; change it later in the console.
OC_LLM_UPSTREAM_URL=
# Provider key: leave empty here and enter it at the install prompt or in the console.
# If you do set it here, install.sh stores it as a secret; then delete it from this file.
OC_LLM_PROVIDER_KEY=
# Optional generic OpenAI-compatible gateway (named endpoints, per-app keys).
# 0 = off. Giving an opted-in app the provider key works either way.
OC_GENERIC_GATEWAY=0
OC_BACKUP_KEEP_DAILY=7
OC_HTTP_PORT=80
OC_HTTPS_PORT=443
# Pin the SeaweedFS image tag for reproducible installs.
OC_SEAWEEDFS_TAG=4.48
# App builds run in a rootless BuildKit container with these limits.
OC_BUILDKIT_TAG=v0.34.0-rootless
OC_BUILD_MEMORY=2g
OC_BUILD_CPUS=1
# Optional: CA bundle (path under OC_ROOT) for an internal HTTPS git server.
OC_GIT_SSL_CAINFO=
# App Map: seconds between health probes of endpoints you mark as checks.
OC_API_PROBE_INTERVAL=60
# Open CloudWatch: seconds between metric samples, and how many days metrics and logs are kept.
OC_WATCH_INTERVAL=60
OC_WATCH_RETENTION_DAYS=7
OC_WATCH_LOG_RETENTION_DAYS=7
# Alarm email (optional; can also be set in the console). TLS: starttls, ssl or none.
OC_SMTP_HOST=
OC_SMTP_PORT=587
OC_SMTP_TLS=starttls
OC_SMTP_USER=
OC_SMTP_FROM=
OC_SMTP_TO=
# Like the provider key: install.sh stores it as a secret; then delete it from this file.
OC_SMTP_PASSWORD=
# Edge: "internal" = Open Cloud's own Caddy (oc-edge) owns 80/443; "external" = an existing reverse proxy fronts
# the console (oc-edge doesn't run, no ports are published, only oc-console joins OC_PROXY_NETWORK).
OC_EDGE_MODE=internal
OC_PROXY_NETWORK=
# Reverse proxies in front of the console that append to X-Forwarded-For (1 for oc-edge or one external proxy).
OC_TRUSTED_PROXIES=1
# Container name of that proxy. The console trusts X-Forwarded-For only from it.
OC_TRUSTED_PROXY_HOSTS=oc-edge
# Observe mode: read-only view (metrics, logs) of containers Open Cloud doesn't manage. Open Cloud never
# changes them. Optional single files mounted read-only: a status.json and backup marker files (space separated;
# wrap several paths in quotes, e.g. OC_OBSERVE_BACKUP_MARKERS="/a/marker /b/marker").
OC_OBSERVE=0
OC_OBSERVE_STATUS_JSON=
OC_OBSERVE_BACKUP_MARKERS=
# External mode only: 1 starts the rootless BuildKit builder (needed for app deploys). Internal mode always runs it.
OC_BUILDER=0
# Host sources and mounts (all optional, empty = off). Space separated absolute paths / names.
# Server folders an app may be built from (App Runner "Server folder" source); copied read-only into the build.
OC_LOCAL_SOURCES=
# Existing docker networks an app may opt in to join (e.g. your proxy's network or a shared LLM gateway network).
OC_ALLOWED_EXTERNAL_NETWORKS=
# Folders an app may mount as data (read-write unless :ro).
OC_ALLOWED_DATA_ROOTS=
# Secret files (or folders of them) an app may mount read-only at /run/secrets/<name>. Open Cloud never reads them.
OC_ALLOWED_SECRET_PATHS=
